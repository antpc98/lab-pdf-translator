{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab-pdf-translator.local/schemas/document.schema.json",
  "title": "Lab PDF Translator raw document",
  "description": "Contrato 1.0.0 para la extracción inmutable de un PDF.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id_scheme_version",
    "document_id",
    "source",
    "extraction",
    "page_count",
    "pages",
    "assets",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id_scheme_version": { "const": 1 },
    "document_id": { "$ref": "#/$defs/uuid" },
    "source": { "$ref": "#/$defs/source" },
    "extraction": { "$ref": "#/$defs/extraction" },
    "page_count": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/page" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.0001
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/nonNegativeNumber" },
        { "$ref": "#/$defs/nonNegativeNumber" },
        { "$ref": "#/$defs/nonNegativeNumber" },
        { "$ref": "#/$defs/nonNegativeNumber" }
      ],
      "items": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "mime_type", "byte_size", "sha256"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "mime_type": { "const": "application/pdf" },
        "byte_size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor_name", "extractor_version", "extracted_at", "status"],
      "properties": {
        "extractor_name": { "type": "string", "minLength": 1 },
        "extractor_version": { "type": "string", "minLength": 1 },
        "extracted_at": { "type": "string", "format": "date-time" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "failed"]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "page_number",
        "printed_page_label",
        "width",
        "height",
        "rotation",
        "media_box",
        "status",
        "blocks",
        "asset_occurrences",
        "warnings"
      ],
      "properties": {
        "page_id": { "$ref": "#/$defs/uuid" },
        "page_number": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "printed_page_label": { "type": ["string", "null"] },
        "width": { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.0001 },
        "height": { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.0001 },
        "rotation": { "type": "integer", "enum": [0, 90, 180, 270] },
        "media_box": {
          "anyOf": [
            { "$ref": "#/$defs/bbox" },
            { "type": "null" }
          ]
        },
        "status": { "$ref": "#/$defs/status" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        },
        "asset_occurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetOccurrence" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "block_order",
        "source_index",
        "block_type",
        "bbox",
        "lines",
        "asset_occurrence_ids"
      ],
      "properties": {
        "block_id": { "$ref": "#/$defs/uuid" },
        "block_order": { "type": "integer", "minimum": 1 },
        "source_index": { "type": "integer", "minimum": 0 },
        "block_type": {
          "type": "string",
          "enum": [
            "title",
            "heading",
            "paragraph",
            "list_item",
            "table",
            "code",
            "image",
            "caption",
            "header",
            "footer",
            "page_number",
            "unknown"
          ]
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/line" }
        },
        "asset_occurrence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "line_order", "source_index", "bbox", "spans"],
      "properties": {
        "line_id": { "$ref": "#/$defs/uuid" },
        "line_order": { "type": "integer", "minimum": 1 },
        "source_index": { "type": "integer", "minimum": 0 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/span" }
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id",
        "span_order",
        "source_index",
        "text",
        "bbox",
        "font",
        "rotation",
        "is_visible"
      ],
      "properties": {
        "span_id": { "$ref": "#/$defs/uuid" },
        "span_order": { "type": "integer", "minimum": 1 },
        "source_index": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "font": { "$ref": "#/$defs/font" },
        "rotation": { "type": "number", "minimum": 0, "exclusiveMaximum": 360, "multipleOf": 0.0001 },
        "is_visible": { "type": "boolean" }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "size", "weight", "style", "color"],
      "properties": {
        "family": { "type": ["string", "null"] },
        "size": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.0001 },
            { "type": "null" }
          ]
        },
        "weight": { "type": "string", "enum": ["normal", "bold", "unknown"] },
        "style": { "type": "string", "enum": ["normal", "italic", "unknown"] },
        "color": {
          "anyOf": [
            { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
            { "type": "null" }
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256", "media_type", "byte_size", "path", "pixel_width", "pixel_height"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/assetId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "type": "string", "minLength": 1 },
        "byte_size": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "pixel_width": { "type": ["integer", "null"], "minimum": 1 },
        "pixel_height": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "assetOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_occurrence_id",
        "asset_id",
        "occurrence_order",
        "source_index",
        "bbox",
        "transform"
      ],
      "properties": {
        "asset_occurrence_id": { "$ref": "#/$defs/uuid" },
        "asset_id": { "$ref": "#/$defs/assetId" },
        "occurrence_order": { "type": "integer", "minimum": 1 },
        "source_index": { "type": "integer", "minimum": 0 },
        "bbox": { "$ref": "#/$defs/bbox" },
        "transform": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "number" }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "scope", "ref_id"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "enum": ["document", "page", "block", "line", "span", "asset"] },
        "ref_id": { "type": ["string", "null"] }
      }
    }
  }
}
