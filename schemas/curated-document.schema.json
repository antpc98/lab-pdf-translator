{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab-pdf-translator.local/schemas/curated-document.schema.json",
  "title": "Lab PDF Translator curated document",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "document_id", "source_raw", "document_profile", "units", "assets", "quality", "warnings"],
  "properties": {
    "schema_version": {"const": "2.1.0"}, "document_id": {"type":"string", "format":"uuid"},
    "source_raw": {"type":"object", "additionalProperties":false, "required":["path","sha256","document_id"], "properties":{"path":{"const":"data/raw/document.json"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"document_id":{"type":"string","format":"uuid"}}},
    "document_profile": {"type":"object"},
    "units": {"type":"array", "items":{"$ref":"#/$defs/unit"}},
    "assets": {"type":"array", "items":{"$ref":"#/$defs/asset"}},
    "quality": {"type":"object", "additionalProperties":false, "required":["metrics"], "properties":{"metrics":{"type":"object"}}},
    "warnings": {"type":"array", "items":{"$ref":"#/$defs/warning"}}
  },
  "$defs": {
    "uuid":{"type":"string","format":"uuid"},
    "source":{"type":"object","additionalProperties":false,"required":["page_ids","block_ids","line_ids","span_ids"],"properties":{"page_ids":{"type":"array","items":{"$ref":"#/$defs/uuid"}},"block_ids":{"type":"array","items":{"$ref":"#/$defs/uuid"}},"line_ids":{"type":"array","items":{"$ref":"#/$defs/uuid"}},"span_ids":{"type":"array","items":{"$ref":"#/$defs/uuid"}}}},
    "segment":{"type":"object","additionalProperties":false,"required":["text","protected","style","source_span_ids"],"properties":{"text":{"type":"string"},"protected":{"type":"boolean"},"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":1},"style":{"type":"object"},"source_span_ids":{"type":"array","items":{"$ref":"#/$defs/uuid"}}},"allOf":[{"if":{"properties":{"protected":{"const":true}},"required":["protected"]},"then":{"required":["start","end"]}}]},
    "unit":{"type":"object","additionalProperties":false,"required":["unit_id","reading_order","reading_order_confidence","type","semantic_type","document_role","classification_family","text","translatable","confidence","classification_signals","source","segments"],"properties":{"unit_id":{"$ref":"#/$defs/uuid"},"reading_order":{"type":"integer","minimum":1},"reading_order_confidence":{"type":"number","minimum":0,"maximum":1},"type":{"enum":["document_title","document_subtitle","chapter_title","section_heading","subsection_heading","paragraph","list_item","code_block","inline_code","caption","figure_label","quote","note","warning","definition","header","footer","page_number","url","email","hash","identifier","image_reference","unknown"]},"semantic_type":{"enum":["title","heading","body_text","list","caption","navigation","metadata","technical","code","page_structure","image","unknown"]},"document_role":{"type":"string"},"classification_family":{"type":"string"},"unknown_reason":{"type":"string"},"text":{"type":"string"},"label":{"type":"string"},"page_reference":{"type":"string"},"page_reference_source_span_ids":{"type":"array","items":{"$ref":"#/$defs/uuid"}},"translatable":{"type":"boolean"},"confidence":{"type":"number","minimum":0,"maximum":1},"classification_signals":{"type":"array","items":{"type":"string"}},"source":{"$ref":"#/$defs/source"},"segments":{"type":"array","items":{"$ref":"#/$defs/segment"}},"lines":{"type":"array","items":{"type":"string"}},"list":{"type":["object","null"]},"asset_occurrence_id":{"type":["string","null"]},"section_path":{"type":"array","items":{"type":"string"}}}},
    "asset":{"type":"object","additionalProperties":false,"required":["asset_id","asset_occurrence_id","page_id"],"properties":{"asset_id":{"type":"string"},"asset_occurrence_id":{"$ref":"#/$defs/uuid"},"page_id":{"$ref":"#/$defs/uuid"}}},
    "warning":{"type":"object","additionalProperties":false,"required":["code","message","ref_id"],"properties":{"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"message":{"type":"string"},"ref_id":{"type":["string","null"]}}}
  }
}
